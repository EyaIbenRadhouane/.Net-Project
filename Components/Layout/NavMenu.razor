@using Microsoft.AspNetCore.Components.Authorization

<div class="d-flex flex-column justify-content-between h-100">
    <nav class="nav flex-column flex-grow-1">
        <AuthorizeView Roles="Chef">
            <Authorized>
                <div class="nav-item px-3 mb-1">
                    <NavLink class="nav-link" href="recettes/dashboard" Match="NavLinkMatch.All">
                        <span class="bi bi-bar-chart-fill me-2" aria-hidden="true"></span> Dashboard des Recettes
                    </NavLink>
                </div>

                <div class="nav-item px-3 mb-1">
                    <NavLink class="nav-link" href="recettes">
                        <span class="bi bi-journal-richtext me-2" aria-hidden="true"></span> Gestion des Recettes
                    </NavLink>
                </div>

                <div class="nav-item px-3 mb-1">
                    <NavLink class="nav-link" href="ingredients/dashboard">
                        <span class="bi bi-speedometer2 me-2" aria-hidden="true"></span> Dashboard des Ingrédients
                    </NavLink>
                </div>

                <div class="nav-item px-3 mb-1">
                    <NavLink class="nav-link" href="ingredients">
                        <span class="bi bi-list-stars me-2" aria-hidden="true"></span> Gestion des Ingrédients
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3 mb-1">
                    <NavLink class="nav-link" href="admin/chefs">
                        <span class="bi bi-people-fill me-2" aria-hidden="true"></span> Administration des Chefs
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="nav-profile-section border-top p-3 bg-dark bg-opacity-25">
        <AuthorizeView>
            <Authorized>
                <div class="d-flex flex-column gap-2 text-light text-truncate">
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <span class="bi bi-person-circle fs-5"></span>
                        <span class="text-truncate">@context.User.Identity?.Name</span>
                    </div>
                    <form action="Account/Logout" method="post" class="w-100">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                            <span class="bi bi-box-arrow-right"></span> Déconnexion
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="px-1">
                    <a class="btn btn-primary btn-sm w-100 d-flex align-items-center justify-content-center gap-2" href="Account/Login">
                        <span class="bi bi-box-arrow-in-right"></span> Se connecter
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>