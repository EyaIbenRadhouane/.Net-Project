@inherits LayoutComponentBase
@inject NavigationManager NavManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @if (!IsAuthPage())
        {
            <div class="top-row px-4 border-bottom d-flex justify-content-end align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-2">
                            <span class="bi bi-person-fill text-secondary"></span>
                            <span class="fw-medium">@context.User.Identity?.Name</span>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        }

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool IsAuthPage()
    {
        var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
        return relativePath.StartsWith("login") || relativePath.StartsWith("signup");
    }
}