@page "/ingredients/dashboard"
@rendermode InteractiveServer
@using Recette.Services
@using IngredientModel = Recette.Models.Ingredient
@inject IIngredientService IngredientService
@inject NavigationManager NavManager

<PageTitle>Dashboard Ingrédients</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>📊 Dashboard des Ingrédients</h3>
    <button class="btn btn-success" @onclick="GoToAdd">
        <span class="bi bi-plus-circle"></span> Ajouter un ingrédient
    </button>
</div>

@if (_isLoading)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm"></span>
        Chargement des données...
    </div>
}
else
{
    @* <div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">@_ingredients!.Count</div>
                    <div>Total ingrédients</div>
                </div>
                <span class="fs-1">🧂</span>
