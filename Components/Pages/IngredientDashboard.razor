                    <div>Moy. kcal/unité</div>
                </div>
                <span class="fs-1">🔥</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">@_minCalories.ToString("F0")</div>
                    <div>Min kcal/unité</div>
                </div>
                <span class="fs-1">⬇️</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">@_maxCalories.ToString("F0")</div>
