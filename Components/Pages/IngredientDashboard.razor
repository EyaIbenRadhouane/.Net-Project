    <div class="mb-3">
        <input class="form-control" placeholder="🔍 Rechercher par nom ou unité..."
               @bind="_search" @bind:event="oninput" />
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Calories / Unité</th>
                <th>Unité</th>
                <th>Niveau calorique</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ingredient in FilteredIngredients)
            {
                <tr>
                    <td class="text-muted">@ingredient.Id</td>
                    <td><strong>@ingredient.Name</strong></td>
                    <td>@ingredient.CaloriesPerUnit kcal</td>
                    <td><span class="badge bg-secondary">@ingredient.Unit</span></td>
                    <td>
                        @{
                            var (barColor, barWidth) = GetCalorieBar(ingredient.CaloriesPerUnit);
                        }
                        <div class="progress" style="height: 18px; min-width: 100px;">
                            <div class="progress-bar @barColor" style="width: @barWidth%">
                                @ingredient.CaloriesPerUnit kcal
                            </div>
                        </div>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1"
                                @onclick="() => GoToEdit(ingredient.Id)">✏️</button>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => Delete(ingredient.Id)">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!FilteredIngredients.Any())
    {
        <div class="alert alert-warning">Aucun ingrédient ne correspond à la recherche.</div>
    }
}

@code {
    private List<IngredientModel>? _ingredients;
    private bool _isLoading = true;
    private string _search = "";

    private double _avgCalories = 0;
    private double _minCalories = 0;
    private double _maxCalories = 0;

    private IEnumerable<IngredientModel> FilteredIngredients =>
        _ingredients!.Where(i =>
            string.IsNullOrWhiteSpace(_search) ||
            i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            i.Unit.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _ingredients = await IngredientService.GetIngredientsAsync();

        if (_ingredients.Any())
        {
            _avgCalories = _ingredients.Average(i => i.CaloriesPerUnit);
            _minCalories = _ingredients.Min(i => i.CaloriesPerUnit);
            _maxCalories = _ingredients.Max(i => i.CaloriesPerUnit);
        }

        _isLoading = false;
    }

    private (string color, int width) GetCalorieBar(double calories)
    {
        if (_maxCalories == 0) return ("bg-secondary", 0);
        int width = (int)(calories / _maxCalories * 100);
        string color = calories < 100 ? "bg-success" : calories < 300 ? "bg-warning" : "bg-danger";
        return (color, Math.Max(width, 5));
    }

    private void GoToAdd() => NavManager.NavigateTo("/ingredients/ajouter");
    private void GoToEdit(int id) => NavManager.NavigateTo($"/ingredients/modifier/{id}");

    private async Task Delete(int id)
    {
        await IngredientService.DeleteIngredientAsync(id);
        _ingredients = await IngredientService.GetIngredientsAsync();
        if (_ingredients.Any())
        {
            _avgCalories = _ingredients.Average(i => i.CaloriesPerUnit);
            _minCalories = _ingredients.Min(i => i.CaloriesPerUnit);
            _maxCalories = _ingredients.Max(i => i.CaloriesPerUnit);
        }
    }
}
