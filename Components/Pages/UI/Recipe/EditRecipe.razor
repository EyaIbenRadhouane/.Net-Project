@page "/recettes/modifier/{Id:int}"
@rendermode InteractiveServer

@using Recette.Services
@using Recette.Models
@using System.IO
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject IRecipeService RecipeService
@inject IIngredientService IngredientService
@inject NavigationManager NavManager
@inject IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Modifier la recette</PageTitle>

<h3>✏️ Modifier la recette</h3>

@if (_isLoading)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm"></span>
        Chargement...
    </div>
}
else
{
    <div class="card" style="max-width: 800px;">
        <div class="card-body">

            <EditForm Model="_recipe"
                      OnValidSubmit="HandleSubmit"
                      FormName="EditRecipeForm">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3 text-center">
                    @if (!string.IsNullOrEmpty(_recipe.ImageUrl))
                    {
                        <img src="@_recipe.ImageUrl"
                             class="img-thumbnail"
                             style="max-height:150px;"
                             alt="Aperçu" />
                    }
                    else
                    {
                        <div class="p-3 bg-light border text-muted">
                            Aucune image définie
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Photo de la recette</label>
                    <InputFile OnChange="UploadRecipeImage"
                               class="form-control"
                               accept=".jpg,.jpeg,.png" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nom de la recette</label>
                    <InputText class="form-control" @bind-Value="_recipe.Name" />
                    <ValidationMessage For="() => _recipe.Name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre de personnes</label>
                    <InputNumber class="form-control" @bind-Value="_recipe.NumberOfPersons" />
                    <ValidationMessage For="() => _recipe.NumberOfPersons" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Calories recette</label>
                    <InputNumber class="form-control" @bind-Value="_recipe.CaloriesRecipe" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Catégorie</label>
                    <InputSelect class="form-select" @bind-Value="_recipe.Category">
                        <option value="">-- Choisir --</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _recipe.Category" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Type de cuisine</label>
                    <InputSelect class="form-select" @bind-Value="_recipe.CuisineType">
                        <option value="">-- Choisir --</option>
                        @foreach (var cuisine in Cuisines)
                        {
                            <option value="@cuisine">@cuisine</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _recipe.CuisineType" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Instructions</label>
                    <InputTextArea class="form-control" @bind-Value="_recipe.Instructions" rows="4" />
                </div>

                <hr />
                <h5>🥗 Ingrédients</h5>

                <div class="row g-2 mb-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Ingrédient</label>
                        <InputSelect class="form-select" @bind-Value="_newIngredientId">
                            <option value="0">-- Sélectionner --</option>
                            @foreach (var ingredient in _availableIngredients)
                            {
                                <option value="@ingredient.Id">
                                    @ingredient.Name (@ingredient.Unit)
                                </option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Quantité</label>
                        <InputNumber class="form-control" @bind-Value="_newIngredientQuantity" step="0.01" />
                    </div>

                    <div class="col-md-3">
                        <button type="button" class="btn btn-success w-100" @onclick="AddIngredientToRecipe">
                            + Ajouter
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_ingredientError))
                {
                    <div class="alert alert-danger">@_ingredientError</div>
                }

                @if (_recipe.RecipeIngredients.Any())
                {
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Ingrédient</th>
                                <th>Quantité</th>
                                <th>Unité</th>
                                <th>Calories</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ri in _recipe.RecipeIngredients.ToList())
                            {
                                <tr>
                                    <td>@ri.Ingredient?.Name</td>
                                    <td>@ri.Quantity</td>
                                    <td>@ri.Ingredient?.Unit</td>
                                    <td>@(ri.Quantity * (ri.Ingredient?.CaloriesPerUnit ?? 0)) kcal</td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveIngredientFromRecipe(ri)">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="alert alert-info">
                        <strong>Total calories :</strong> @_recipe.TotalCalories.ToString("0.00") kcal<br />
                        <strong>Calories par personne :</strong> @_recipe.CaloriesPerPerson.ToString("0.00") kcal
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
                    <button type="button" class="btn btn-secondary" @onclick="GoToList">Annuler</button>
                </div>

            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Recipe _recipe = new() { RecipeIngredients = new List<RecipeIngredient>() };
    private List<Ingredient> _availableIngredients = new();
    private int _newIngredientId;
    private double _newIngredientQuantity = 1;
    private bool _isLoading = false;
    private string _ingredientError = string.Empty;
    private string _errorMessage = string.Empty;
    private string? _currentChefId;

    private List<string> Categories => new() { "Petit-déjeuner", "Déjeuner", "Dîner", "Dessert" };
    private List<string> Cuisines => new() { "Tunisienne", "Française", "Italienne", "Méditerranéenne" };

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentChefId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await LoadIngredientsAsync();

        var found = await RecipeService.GetRecipeByIdAsync(Id);
        if (found == null || found.ChefId != _currentChefId)
        {
            GoToList();
            return;
        }

        _recipe = found;
        _isLoading = false;
    }

    private async Task LoadIngredientsAsync()
    {
        var result = await IngredientService.GetIngredientsAsync();
        _availableIngredients = result.Where(i => i.ChefId == _currentChefId).ToList();
    }

    private void AddIngredientToRecipe()
    {
        _ingredientError = string.Empty;

        if (_newIngredientId <= 0)
        {
            _ingredientError = "Veuillez sélectionner un ingrédient.";
            return;
        }

        if (_newIngredientQuantity <= 0)
        {
            _ingredientError = "La quantité doit être supérieure à 0.";
            return;
        }

        if (_recipe.RecipeIngredients.Any(ri => ri.IngredientId == _newIngredientId))
        {
            _ingredientError = "Cet ingrédient est déjà présent dans la recette.";
            return;
        }

        var selected = _availableIngredients.FirstOrDefault(i => i.Id == _newIngredientId);
        if (selected != null)
        {
            _recipe.RecipeIngredients.Add(new RecipeIngredient
            {
                IngredientId = _newIngredientId,
                Ingredient = selected,
                Quantity = _newIngredientQuantity
            });

            _newIngredientId = 0;
            _newIngredientQuantity = 1;
        }
    }

    private void RemoveIngredientFromRecipe(RecipeIngredient ri)
    {
        _recipe.RecipeIngredients.Remove(ri);
    }

    private async Task UploadRecipeImage(InputFileChangeEventArgs e)
    {
        var file = e.File;
        try
        {
            var fileName = Guid.NewGuid() + Path.GetExtension(file.Name);
            var folderPath = Path.Combine(Env.WebRootPath, "images", "recipes");

            if (!Directory.Exists(folderPath))
                Directory.CreateDirectory(folderPath);

            var path = Path.Combine(folderPath, fileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var fileStream = new FileStream(path, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            _recipe.ImageUrl = $"/images/recipes/{fileName}";
        }
        catch (Exception)
        {
            _errorMessage = "Erreur lors du chargement de l'image.";
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            await RecipeService.UpdateRecipeAsync(_recipe);
            GoToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur lors de la modification : {ex.Message}";
        }
    }

    private void GoToList() => NavManager.NavigateTo("/recettes");
}