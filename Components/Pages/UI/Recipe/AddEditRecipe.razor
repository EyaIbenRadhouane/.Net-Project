@page "/recettes/ajouter"
@page "/recettes/modifier/{Id:int}"
@rendermode InteractiveServer
@using Recette.Services
@using Recette.Models
@inject IRecipeService RecipeService
@inject IIngredientService IngredientService
@inject NavigationManager NavManager

<PageTitle>@(_isEditMode ? "Modifier" : "Ajouter") une recette</PageTitle>

<h3>@(_isEditMode ? "✏️ Modifier la recette" : "➕ Ajouter une recette")</h3>

@if (_isLoading)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm"></span> Chargement...
    </div>
}
else
{
    <div class="card" style="max-width: 800px;">
        <div class="card-body">
            <EditForm Model="_recipe" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <!-- 📋 Champs de base de la recette -->
                <div class="mb-3">
                    <label class="form-label">Nom de la recette</label>
                    <InputText class="form-control" @bind-Value="_recipe.Name"
                               placeholder="ex : Salade Tunisienne" />
                    <ValidationMessage For="() => _recipe.Name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre de personnes</label>
                    <InputNumber class="form-control" @bind-Value="_recipe.NumberOfPersons" />
                    <ValidationMessage For="() => _recipe.NumberOfPersons" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Calories de la recette (kcal)</label>
                    <InputNumber class="form-control" @bind-Value="_recipe.CaloriesRecipe"
                                 placeholder="ex : 450" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Catégorie</label>
                    <InputSelect class="form-select" @bind-Value="_recipe.Category">
                        <option value="">-- Choisir --</option>
                        <option value="Petit-déjeuner">Petit-déjeuner</option>
                        <option value="Déjeuner">Déjeuner</option>
                        <option value="Dîner">Dîner</option>
                        <option value="Dessert">Dessert</option>
                    </InputSelect>
                    <ValidationMessage For="() => _recipe.Category" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Type de cuisine</label>
                    <InputSelect class="form-select" @bind-Value="_recipe.CuisineType">
                        <option value="">-- Choisir --</option>
                        <option value="Tunisienne">Tunisienne</option>
                        <option value="Française">Française</option>
                        <option value="Italienne">Italienne</option>
                        <option value="Méditerranéenne">Méditerranéenne</option>
                    </InputSelect>
                    <ValidationMessage For="() => _recipe.CuisineType" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Instructions</label>
                    <InputTextArea class="form-control" @bind-Value="_recipe.Instructions"
                                   rows="4" placeholder="Décrivez les étapes..." />
                    <ValidationMessage For="() => _recipe.Instructions" class="text-danger" />
                </div>

                <!-- 🥗 Section Ingrédients -->
                <hr />
                <h5>🥗 Ingrédients</h5>
                
                <!-- Formulaire d'ajout d'ingrédient -->
                <div class="row g-2 mb-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Ingrédient</label>
                        <InputSelect class="form-select" @bind-Value="_newIngredientId">
                            <option value="0">-- Sélectionner un ingrédient --</option>
                            @foreach (var ingredient in _availableIngredients)
                            {
                                <option value="@ingredient.Id">@ingredient.Name (@ingredient.Unit)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Quantité</label>
                        <InputNumber class="form-control" @bind-Value="_newIngredientQuantity" 
                                     step="0.01" placeholder="ex : 2.5" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-success w-100" @onclick="AddIngredientToRecipe">
                            + Ajouter
                        </button>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(_ingredientError))
                {
                    <div class="alert alert-danger py-1">@_ingredientError</div>
                }

                <!-- 📋 Liste des ingrédients ajoutés -->
                @if (_recipe.RecipeIngredients?.Any() == true)
                {
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Ingrédient</th>
                                <th>Quantité</th>
                                <th>Unité</th>
                                <th>Calories</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ri in _recipe.RecipeIngredients.ToList())
                            {
                                <tr>
                                    <td>@ri.Ingredient?.Name</td>
                                    <td>@ri.Quantity.ToString("0.##")</td>
                                    <td>@ri.Ingredient?.Unit</td>
                                    <td>@(ri.Quantity * (ri.Ingredient?.CaloriesPerUnit ?? 0)) kcal</td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm" 
                                                @onclick="() => RemoveIngredientFromRecipe(ri)">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <!-- 📊 Totaux calculés -->
                    <div class="alert alert-info mb-3">
                        <strong>🔥 Total calories :</strong> @_recipe.TotalCalories.ToString("0.00") kcal<br />
                        <strong>👤 Calories par personne :</strong> @_recipe.CaloriesPerPerson.ToString("0.00") kcal
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">Aucun ingrédient ajouté pour le moment.</div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        @(_isEditMode ? "💾 Enregistrer" : "✅ Ajouter")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="GoToList">
                        Annuler
                    </button>
                </div>

            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Recipe _recipe = new();
    private List<Ingredient> _availableIngredients = new();
    private int _newIngredientId;
    private double _newIngredientQuantity = 1;
    private string _ingredientError = string.Empty;
    
    private bool _isEditMode = false;
    private bool _isLoading = false;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // 1️⃣ Charger la liste des ingrédients disponibles
        await LoadIngredientsAsync();
        
        // 2️⃣ Si mode édition, charger la recette
        if (Id.HasValue)
        {
            _isEditMode = true;
            _isLoading = true;
            StateHasChanged();
            
            var found = await RecipeService.GetRecipeByIdAsync(Id.Value);
            if (found != null)
            {
                _recipe = found;
                
                // 🔄 Associer les objets Ingredient complets aux RecipeIngredients
                // (car l'API peut ne pas retourner les données de navigation)
                if (_recipe.RecipeIngredients != null)
                {
                    foreach (var ri in _recipe.RecipeIngredients)
                    {
                        if (ri.IngredientId > 0 && ri.Ingredient == null)
                        {
                            ri.Ingredient = _availableIngredients
                                .FirstOrDefault(i => i.Id == ri.IngredientId);
                        }
                    }
                }
            }
            else
            {
                NavManager.NavigateTo("/recettes");
            }
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadIngredientsAsync()
    {
        _availableIngredients = await IngredientService.GetIngredientsAsync() 
            ?? new List<Ingredient>();
    }

    private void AddIngredientToRecipe()
    {
        _ingredientError = string.Empty;
        
        // ✅ Validations
        if (_newIngredientId <= 0)
        {
            _ingredientError = "⚠️ Veuillez sélectionner un ingrédient.";
            return;
        }
        
        if (_newIngredientQuantity <= 0)
        {
            _ingredientError = "⚠️ La quantité doit être supérieure à 0.";
            return;
        }

        var ingredient = _availableIngredients
            .FirstOrDefault(i => i.Id == _newIngredientId);
            
        if (ingredient == null)
        {
            _ingredientError = "⚠️ Ingrédient non trouvé.";
            return;
        }

        // 🚫 Vérifier si l'ingrédient est déjà dans la recette
        var existing = _recipe.RecipeIngredients?
            .FirstOrDefault(ri => ri.IngredientId == _newIngredientId);
            
        if (existing != null)
        {
            _ingredientError = "⚠️ Cet ingrédient est déjà dans la recette.";
            return;
        }

        // ➕ Initialiser la collection si nécessaire
        if (_recipe.RecipeIngredients == null)
            _recipe.RecipeIngredients = new List<RecipeIngredient>();

        // 🆕 Créer et ajouter le nouvel élément
        var recipeIngredient = new RecipeIngredient
        {
            IngredientId = _newIngredientId,
            Ingredient = ingredient, // Important pour l'affichage immédiat
            Quantity = _newIngredientQuantity
        };

        _recipe.RecipeIngredients.Add(recipeIngredient);

        // 🔄 Réinitialiser les champs de saisie
        _newIngredientId = 0;
        _newIngredientQuantity = 1;
        
        // 🎯 Forcer le re-rendu pour afficher les changements
        StateHasChanged();
    }

    private void RemoveIngredientFromRecipe(RecipeIngredient recipeIngredient)
    {
        _recipe.RecipeIngredients?.Remove(recipeIngredient);
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        _errorMessage = string.Empty;
        
        // ✅ Validation : au moins un ingrédient requis
        if (_recipe.RecipeIngredients == null || !_recipe.RecipeIngredients.Any())
        {
            _errorMessage = "⚠️ Veuillez ajouter au moins un ingrédient à la recette.";
            return;
        }
        
        try
        {
            if (_isEditMode)
                await RecipeService.UpdateRecipeAsync(_recipe);
            else
                await RecipeService.AddRecipeAsync(_recipe);

            NavManager.NavigateTo("/recettes");
        }
        catch (Exception ex)
        {
            _errorMessage = $"❌ Erreur : {ex.Message}";
            // 📝 Pour le débogage : Console.WriteLine(ex);
        }
    }

    private void GoToList()
    {
        NavManager.NavigateTo("/recettes");
    }
}