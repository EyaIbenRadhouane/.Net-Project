@page "/recettes/ajouter"
@page "/recettes/modifier/{Id:int}"
@rendermode InteractiveServer
@using Recette.Services
@using Recette.Models
@using System.IO
@inject IRecipeService RecipeService
@inject IIngredientService IngredientService
@inject NavigationManager NavManager
@inject IWebHostEnvironment Env

<PageTitle>@(_isEditMode ? "Modifier" : "Ajouter") une recette</PageTitle>

<h3>@(_isEditMode ? "✏️ Modifier la recette" : "➕ Ajouter une recette")</h3>

@if (_isLoading)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm"></span> Chargement...
    </div>
}
else
{
    <div class="card" style="max-width: 800px;">
        <div class="card-body">
            <EditForm Model="_recipe" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @* --- SECTION IMAGE --- *@
                <div class="mb-3 text-center">
                    @if (!string.IsNullOrEmpty(_recipe.ImageUrl))
                    {
                        <img src="@_recipe.ImageUrl" class="img-thumbnail" style="max-height: 150px;" alt="Aperçu" />
                    }
                    else
                    {
                        <div class="p-3 bg-light border text-muted">Aucune image définie</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Photo de la recette (local)</label>
                    @* Correction : Le nom de la méthode doit correspondre à celui dans @code *@
                    <InputFile OnChange="UploadRecipeImage" class="form-control" accept=".jpg,.jpeg,.png" />
                </div>

                @* --- Champs de base --- *@
                <div class="mb-3">
                    <label class="form-label">Nom de la recette</label>
                    <InputText class="form-control" @bind-Value="_recipe.Name" placeholder="ex : Salade Tunisienne" />
                    <ValidationMessage For="() => _recipe.Name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre de personnes</label>
                    <InputNumber class="form-control" @bind-Value="_recipe.NumberOfPersons" />
                    <ValidationMessage For="() => _recipe.NumberOfPersons" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Calories de la recette (kcal)</label>
                    <InputNumber class="form-control" @bind-Value="_recipe.CaloriesRecipe" placeholder="ex : 450" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Catégorie</label>
                    <InputSelect class="form-select" @bind-Value="_recipe.Category">
                        <option value="">-- Choisir --</option>
                        <option value="Petit-déjeuner">Petit-déjeuner</option>
                        <option value="Déjeuner">Déjeuner</option>
                        <option value="Dîner">Dîner</option>
                        <option value="Dessert">Dessert</option>
                    </InputSelect>
                    <ValidationMessage For="() => _recipe.Category" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Type de cuisine</label>
                    <InputSelect class="form-select" @bind-Value="_recipe.CuisineType">
                        <option value="">-- Choisir --</option>
                        <option value="Tunisienne">Tunisienne</option>
                        <option value="Française">Française</option>
                        <option value="Italienne">Italienne</option>
                        <option value="Méditerranéenne">Méditerranéenne</option>
                    </InputSelect>
                    <ValidationMessage For="() => _recipe.CuisineType" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Instructions</label>
                    <InputTextArea class="form-control" @bind-Value="_recipe.Instructions" rows="4" placeholder="Décrivez les étapes..." />
                    <ValidationMessage For="() => _recipe.Instructions" class="text-danger" />
                </div>

                @* --- Section Ingrédients --- *@
                <hr />
                <h5>🥗 Ingrédients</h5>
                
                <div class="row g-2 mb-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Ingrédient</label>
                        <InputSelect class="form-select" @bind-Value="_newIngredientId">
                            <option value="0">-- Sélectionner --</option>
                            @foreach (var ingredient in _availableIngredients)
                            {
                                <option value="@ingredient.Id">@ingredient.Name (@ingredient.Unit)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Quantité</label>
                        <InputNumber class="form-control" @bind-Value="_newIngredientQuantity" step="0.01" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-success w-100" @onclick="AddIngredientToRecipe">+ Ajouter</button>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(_ingredientError))
                {
                    <div class="alert alert-danger py-1">@_ingredientError</div>
                }

                @if (_recipe.RecipeIngredients?.Any() == true)
                {
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Ingrédient</th>
                                <th>Quantité</th>
                                <th>Unité</th>
                                <th>Calories</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ri in _recipe.RecipeIngredients.ToList())
                            {
                                <tr>
                                    <td>@ri.Ingredient?.Name</td>
                                    <td>@ri.Quantity.ToString("0.##")</td>
                                    <td>@ri.Ingredient?.Unit</td>
                                    <td>@(ri.Quantity * (ri.Ingredient?.CaloriesPerUnit ?? 0)) kcal</td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveIngredientFromRecipe(ri)">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <div class="alert alert-info mb-3">
                        <strong>🔥 Total calories :</strong> @_recipe.TotalCalories.ToString("0.00") kcal<br />
                        <strong>👤 Calories par personne :</strong> @_recipe.CaloriesPerPerson.ToString("0.00") kcal
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        @(_isEditMode ? "💾 Enregistrer" : "✅ Ajouter")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="GoToList">Annuler</button>
                </div>

            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Recipe _recipe = new();
    private List<Ingredient> _availableIngredients = new();
    private int _newIngredientId;
    private double _newIngredientQuantity = 1;
    private string _ingredientError = string.Empty;
    
    private bool _isEditMode = false;
    private bool _isLoading = false;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadIngredientsAsync();
        
        if (Id.HasValue)
        {
            _isEditMode = true;
            _isLoading = true;
            
            var found = await RecipeService.GetRecipeByIdAsync(Id.Value);
            if (found != null)
            {
                _recipe = found;
                if (_recipe.RecipeIngredients != null)
                {
                    foreach (var ri in _recipe.RecipeIngredients)
                    {
                        if (ri.IngredientId > 0 && ri.Ingredient == null)
                        {
                            ri.Ingredient = _availableIngredients.FirstOrDefault(i => i.Id == ri.IngredientId);
                        }
                    }
                }
            }
            else
            {
                NavManager.NavigateTo("/recettes");
            }
            _isLoading = false;
        }
    }

    private async Task LoadIngredientsAsync()
    {
        var result = await IngredientService.GetIngredientsAsync();
        _availableIngredients = result ?? new List<Ingredient>();
    }

    private async Task UploadRecipeImage(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try 
            {
                var fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.Name);
                var folderPath = Path.Combine(Env.WebRootPath, "images", "recipes");
                
                if (!Directory.Exists(folderPath)) Directory.CreateDirectory(folderPath);
                
                var path = Path.Combine(folderPath, fileName);

                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
                using var fileStream = new FileStream(path, FileMode.Create);
                await stream.CopyToAsync(fileStream);

                // Correction : On assigne l'URL à _recipe.ImageUrl et non à _ingredient
                _recipe.ImageUrl = $"/images/recipes/{fileName}";
            }
            catch (Exception ex)
            {
                _errorMessage = $"Erreur lors de l'upload : {ex.Message}";
            }
        }
    }

    private void AddIngredientToRecipe()
    {
        _ingredientError = string.Empty;
        if (_newIngredientId <= 0) { _ingredientError = "⚠️ Sélectionnez un ingrédient."; return; }
        if (_newIngredientQuantity <= 0) { _ingredientError = "⚠️ Quantité invalide."; return; }

        var ingredient = _availableIngredients.FirstOrDefault(i => i.Id == _newIngredientId);
        if (ingredient == null) return;

        if (_recipe.RecipeIngredients?.Any(ri => ri.IngredientId == _newIngredientId) == true)
        {
            _ingredientError = "⚠️ Déjà présent.";
            return;
        }

        if (_recipe.RecipeIngredients == null) _recipe.RecipeIngredients = new List<RecipeIngredient>();

        _recipe.RecipeIngredients.Add(new RecipeIngredient
        {
            IngredientId = _newIngredientId,
            Ingredient = ingredient,
            Quantity = _newIngredientQuantity
        });

        _newIngredientId = 0;
        _newIngredientQuantity = 1;
    }

    private void RemoveIngredientFromRecipe(RecipeIngredient recipeIngredient)
    {
        _recipe.RecipeIngredients?.Remove(recipeIngredient);
    }

    private async Task HandleSubmit()
    {
        if (_recipe.RecipeIngredients == null || !_recipe.RecipeIngredients.Any())
        {
            _errorMessage = "⚠️ Ajoutez au moins un ingrédient.";
            return;
        }
        
        try
        {
            if (_isEditMode)
                await RecipeService.UpdateRecipeAsync(_recipe);
            else
                await RecipeService.AddRecipeAsync(_recipe);

            NavManager.NavigateTo("/recettes");
        }
        catch (Exception ex)
        {
            _errorMessage = $"❌ Erreur : {ex.Message}";
        }
    }

    private void GoToList() => NavManager.NavigateTo("/recettes");
}