@page "/recettes/dashboard"
@rendermode InteractiveServer
@using Recette.Services
@using Recette.Models
@using Radzen.Blazor
@inject IRecipeService RecipeService

<PageTitle>Dashboard Analytique – Recettes</PageTitle>

<h3 class="mb-4">📊 Dashboard Analytique des Recettes</h3>

@if (_isLoading)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm"></span> Chargement des données...
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@_recipes.Count</div>
                        <div>Total recettes</div>
                    </div>
                    <span class="fs-1">📖</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@_categoryData.Count</div>
                        <div>Catégories</div>
                    </div>
                    <span class="fs-1">🏷️</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@_cuisineData.Count</div>
                        <div>Types de cuisine</div>
                    </div>
                    <span class="fs-1">🌍</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@_avgCaloriesPerPerson.ToString("F0") kcal</div>
                        <div>Moy. cal/personne</div>
                    </div>
                    <span class="fs-1">🔥</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">🥗 Répartition par Catégorie</div>
                <div class="card-body">
                    <RadzenChart>
                        <RadzenPieSeries Data="@_categoryData"
                                         Title="Recettes"
                                         CategoryProperty="Category"
                                         ValueProperty="Count"
                                         TItem="CategoryStat">
                            <TooltipTemplate Context="item">
                                <div>
                                    <strong>@item.Category</strong><br />
                                    @item.Count recette(s)<br />
                                    Moy. @item.AvgCaloriesPerPerson.ToString("F0") kcal/pers
                                </div>
                            </TooltipTemplate>
                        </RadzenPieSeries>
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">🌍 Répartition par Cuisine</div>
                <div class="card-body">
                    <RadzenChart>
                        <RadzenDonutSeries Data="@_cuisineData"
                                           Title="Cuisines"
                                           CategoryProperty="CuisineType"
                                           ValueProperty="Count"
                                           TItem="CuisineStat">
                            <TooltipTemplate Context="item">
                                <div>
                                    <strong>@item.CuisineType</strong><br />
                                    @item.Count recette(s)
                                </div>
                            </TooltipTemplate>
                        </RadzenDonutSeries>
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">⚡ Jauge Calorique Moyenne</div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <RadzenRadialGauge Style="width:100%;max-width:280px;height:200px">
                        <RadzenRadialGaugeScale Min="0"
                                               Max="@_maxCaloriesPerPerson"
                                               Step="@(_maxCaloriesPerPerson / 5)"
                                               TickPosition="GaugeTickPosition.Outside"
                                               MinorStep="@(_maxCaloriesPerPerson / 20)">
                            <RadzenRadialGaugeScaleRange From="0"
                                                         To="@(_maxCaloriesPerPerson * 0.33)"
                                                         Fill="green" />

                            <RadzenRadialGaugeScaleRange From="@(_maxCaloriesPerPerson * 0.33)"
                                                         To="@(_maxCaloriesPerPerson * 0.66)"
                                                         Fill="orange" />

                            <RadzenRadialGaugeScaleRange From="@(_maxCaloriesPerPerson * 0.66)"
                                                         To="@_maxCaloriesPerPerson"
                                                         Fill="red" />

                            <RadzenRadialGaugeScalePointer Value="@_avgCaloriesPerPerson"
                                                           ShowValue="true"
                                                           Length="0.6" />
                        </RadzenRadialGaugeScale>
                    </RadzenRadialGauge>

                    <p class="text-muted mt-2 text-center">
                        Moyenne : <strong>@_avgCaloriesPerPerson.ToString("F0") kcal</strong> / personne
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">🔥 Calories moyennes par catégorie</div>
        <div class="card-body">
            <RadzenChart Style="height:220px">
                <RadzenColumnSeries Data="@_categoryData"
                                    Title="Moy. kcal/pers"
                                    CategoryProperty="Category"
                                    ValueProperty="AvgCaloriesPerPerson"
                                    TItem="CategoryStat"
                                    Fill="#e74c3c" />
                <RadzenCategoryAxis Padding="20" />
                <RadzenValueAxis>
                    <RadzenGridLines Visible="true" />
                </RadzenValueAxis>
                <RadzenLegend Visible="false" />
            </RadzenChart>
        </div>
    </div>
}

@code {
    public class CategoryStat
    {
        public string Category { get; set; } = "";
        public int Count { get; set; }
        public double AvgCaloriesPerPerson { get; set; }
    }

    public class CuisineStat
    {
        public string CuisineType { get; set; } = "";
        public int Count { get; set; }
    }

    private List<Recipe> _recipes = new();
    private List<CategoryStat> _categoryData = new();
    private List<CuisineStat> _cuisineData = new();

    private double _avgCaloriesPerPerson;
    private double _maxCaloriesPerPerson;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _recipes = await RecipeService.GetRecipesAsync();
        BuildAggregations();
        _isLoading = false;
    }

    private void BuildAggregations()
    {
        _categoryData = _recipes
            .GroupBy(r => r.Category)
            .Select(g => new CategoryStat
            {
                Category = g.Key,
                Count = g.Count(),
                AvgCaloriesPerPerson = g.Average(r => r.CaloriesPerPerson)
            })
            .OrderByDescending(c => c.Count)
            .ToList();

        _cuisineData = _recipes
            .GroupBy(r => r.CuisineType)
            .Select(g => new CuisineStat
            {
                CuisineType = g.Key,
                Count = g.Count()
            })
            .OrderByDescending(c => c.Count)
            .ToList();

        _avgCaloriesPerPerson = _recipes.Any()
            ? _recipes.Average(r => r.CaloriesPerPerson)
            : 0;

        _maxCaloriesPerPerson = _recipes.Any()
            ? Math.Max(_recipes.Max(r => r.CaloriesPerPerson), 800)
            : 800;
    }
}