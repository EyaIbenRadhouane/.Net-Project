@page "/ingredients/dashboard"
@rendermode InteractiveServer
@using Recette.Services
@using Recette.Models
@using Radzen
@using Radzen.Blazor
@using IngredientModel = Recette.Models.Ingredient
@inject IIngredientService IngredientService
@inject NavigationManager NavManager

<PageTitle>Dashboard Ingrédients</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>📊 Dashboard des Ingrédients</h3>
    <button class="btn btn-success" @onclick="GoToAdd">
        <span class="bi bi-plus-circle"></span> Ajouter un ingrédient
    </button>
</div>

@if (_isLoading)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm"></span> Chargement des données...
    </div>
}
else
{
    <!-- 📊 Cartes de statistiques -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@(_filteredIngredients?.Count ?? 0)</div>
                        <div>Total ingrédients</div>
                    </div>
                    <span class="fs-1">🧂</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@_avgCalories.ToString("F0")</div>
                        <div>Moy. kcal/unité</div>
                    </div>
                    <span class="fs-1">🔥</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@_minCalories.ToString("F0")</div>
                        <div>Min kcal/unité</div>
                    </div>
                    <span class="fs-1">⬇️</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@_maxCalories.ToString("F0")</div>
                        <div>Max kcal/unité</div>
                    </div>
                    <span class="fs-1">⬆️</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 📈 Graphiques -->
    <div class="row g-3 mb-4">
        <!-- Pie Chart: Répartition par Catégorie -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📈 Répartition par Catégorie</h5>
                </div>
                <div class="card-body">
                    @if (_categoryData?.Any() == true)
                    {
                        <RadzenChart>
                            <RadzenPieSeries Data="@_categoryData" CategoryProperty="Category" ValueProperty="Count">
                                <RadzenSeriesDataLabels Visible="true" />
                            </RadzenPieSeries>
                            <RadzenChartTooltip />
                        </RadzenChart>
                    }
                    else
                    {
                        <div class="alert alert-warning">Aucune donnée disponible</div>
                    }
                </div>
            </div>
        </div>

        <!-- Bar Chart: Top 10 Ingrédients par Calories -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">🔥 Top 10 Ingrédients (Calories)</h5>
                </div>
                <div class="card-body">
                    @if (_topCalories?.Any() == true)
                    {
                        <RadzenChart>
                            <RadzenBarSeries Data="@_topCalories" CategoryProperty="Name" ValueProperty="CaloriesPerUnit">
                                <RadzenSeriesDataLabels Visible="true" />
                            </RadzenBarSeries>
                            <RadzenChartTooltip />
                            <RadzenCategoryAxis />
                            <RadzenValueAxis Min="0" Max="@(_topCalories.Any() ? _topCalories.Max(x => x.CaloriesPerUnit) * 1.1 : 100)">
                                <RadzenAxisTitle Text="kcal/unité" />
                            </RadzenValueAxis>
                        </RadzenChart>
                    }
                    else
                    {
                        <div class="alert alert-warning">Aucune donnée disponible</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- Bar Chart: Distribution des Calories -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">📊 Distribution des Calories</h5>
                </div>
                <div class="card-body">
                    @if (_calorieDistribution?.Any() == true)
                    {
                        <RadzenChart>
                            <RadzenBarSeries Data="@_calorieDistribution" CategoryProperty="Range" ValueProperty="Count">
                                <RadzenSeriesDataLabels Visible="true" />
                            </RadzenBarSeries>
                            <RadzenChartTooltip />
                            <RadzenCategoryAxis />
                            <RadzenValueAxis Min="0">
                                <RadzenAxisTitle Text="Nombre d'ingrédients" />
                            </RadzenValueAxis>
                        </RadzenChart>
                    }
                    else
                    {
                        <div class="alert alert-warning">Aucune donnée disponible</div>
                    }
                </div>
            </div>
        </div>

        <!-- Card: Résumé Nutritionnel -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">🥗 Résumé Nutritionnel</h5>
                </div>
                <div class="card-body">
                    @if (_filteredIngredients?.Any() == true)
                    {
                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="p-2 bg-light rounded">
                                    <small class="text-muted">Avg. Protéines</small>
                                    <div class="fs-4 fw-bold">@_avgProteins.ToString("F1")g</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 bg-light rounded">
                                    <small class="text-muted">Avg. Glucides</small>
                                    <div class="fs-4 fw-bold">@_avgCarbs.ToString("F1")g</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 bg-light rounded">
                                    <small class="text-muted">Avg. Lipides</small>
                                    <div class="fs-4 fw-bold">@_avgLipids.ToString("F1")g</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 bg-light rounded">
                                    <small class="text-muted">Avg. Fibres</small>
                                    <div class="fs-4 fw-bold">@_avgFiber.ToString("F1")g</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">Aucune donnée disponible</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 🔍 Recherche -->
    <div class="mb-3">
        <input class="form-control" 
               placeholder="🔍 Recherche par nom, unité ou catégorie..."
               @bind="_searchText" 
               @bind:event="oninput" />
    </div>

    <!-- Filtres -->
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Filtrer par catégorie</label>
            <select class="form-select" @bind="_selectedCategory">
                <option value="">Toutes les catégories</option>
                @foreach (var category in Enum.GetValues<IngredientCategory>())
                {
                    <option value="@category">@GetCategoryLabel(category)</option>
                }
            </select>
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                <span class="bi bi-x-circle"></span> Effacer filtres
            </button>
        </div>
    </div>

    <!-- 📋 Tableau des ingrédients -->
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Image</th>
                <th>Nom</th>
                <th>Catégorie</th>
                <th>Calories / Unité</th>
                <th>Unité</th>
                <th>Niveau calorique</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_filteredIngredients?.Any() == true)
            {
                @foreach (var ingredient in _filteredIngredients)
                {
                    <tr>
                        <td class="text-muted">@ingredient.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(ingredient.ImageUrl))
                            {
                                <img src="@ingredient.ImageUrl" 
                                     alt="@ingredient.Name" 
                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                            }
                            else
                            {
                                <div style="width: 50px; height: 50px; background-color: #eee; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                                    🧂
                                </div>
                            }
                        </td>
                        <td><strong>@ingredient.Name</strong></td>
                        <td>
                            @{
                                var (badgeColor, badgeEmoji) = GetCategoryBadge(ingredient.Category);
                            }
                            <span class="badge @badgeColor">@badgeEmoji @GetCategoryLabel(ingredient.Category)</span>
                        </td>
                        <td>@ingredient.CaloriesPerUnit kcal</td>
                        <td><span class="badge bg-secondary">@ingredient.Unit</span></td>
                        <td>
                            @{
                                var (barColor, barWidth) = GetCalorieBar(ingredient.CaloriesPerUnit);
                            }
                            <div class="progress" style="height: 18px; min-width: 100px;">
                                <div class="progress-bar @barColor" style="width: @barWidth%">
                                    @ingredient.CaloriesPerUnit kcal
                                </div>
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => GoToEdit(ingredient.Id)">✏️</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Delete(ingredient.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4">
                        <div class="alert alert-warning mb-0">Aucun ingrédient ne correspond aux filtres appliqués.</div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<IngredientModel>? _allIngredients;
    private List<IngredientModel>? _filteredIngredients;
    private bool _isLoading = true;
    private string _searchText = string.Empty;
    private IngredientCategory? _selectedCategory;

    private double _avgCalories = 0;
    private double _minCalories = 0;
    private double _maxCalories = 0;

    // Données pour les graphiques
    private List<CategoryData>? _categoryData = new();
    private List<IngredientModel>? _topCalories = new();
    private List<CalorieRangeData>? _calorieDistribution = new();

    // Moyennes nutritionnelles
    private double _avgProteins = 0;
    private double _avgCarbs = 0;
    private double _avgLipids = 0;
    private double _avgFiber = 0;

    private IEnumerable<IngredientModel> FilteredIngredients =>
        ApplyFilters(_allIngredients?.AsQueryable() ?? Enumerable.Empty<IngredientModel>().AsQueryable());

    private IQueryable<IngredientModel> ApplyFilters(IQueryable<IngredientModel> query)
    {
        // Filtre textuel
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(i =>
                i.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                i.Unit.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                GetCategoryLabel(i.Category).Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }

        // Filtre par catégorie
        if (_selectedCategory.HasValue)
        {
            query = query.Where(i => i.Category == _selectedCategory.Value);
        }

        return query;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        _allIngredients = await IngredientService.GetIngredientsAsync();

        if (_allIngredients?.Any() == true)
        {
            RefreshFilteredData();
        }

        _isLoading = false;
        StateHasChanged();
    }

    private void RefreshFilteredData()
    {
        _filteredIngredients = FilteredIngredients.ToList();
        CalculateStatistics();
        CalculateChartData();
        CalculateNutritionAverage();
    }

    private void CalculateStatistics()
    {
        if (_filteredIngredients?.Any() != true)
        {
            _avgCalories = _minCalories = _maxCalories = 0;
            return;
        }

        _avgCalories = _filteredIngredients.Average(i => i.CaloriesPerUnit);
        _minCalories = _filteredIngredients.Min(i => i.CaloriesPerUnit);
        _maxCalories = _filteredIngredients.Max(i => i.CaloriesPerUnit);
    }

    private void CalculateChartData()
    {
        if (_filteredIngredients == null || !_filteredIngredients.Any())
        {
            _categoryData?.Clear();
            _topCalories?.Clear();
            _calorieDistribution?.Clear();
            return;
        }

        // Répartition par catégorie
        _categoryData = _filteredIngredients
            .GroupBy(i => GetCategoryLabel(i.Category))
            .Select(g => new CategoryData { Category = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToList();

        // Top 10 ingrédients par calories
        _topCalories = _filteredIngredients
            .OrderByDescending(i => i.CaloriesPerUnit)
            .Take(10)
            .ToList();

        // Distribution des calories par plage
        _calorieDistribution = new List<CalorieRangeData>
        {
            new() { Range = "< 50 kcal", Count = _filteredIngredients.Count(i => i.CaloriesPerUnit < 50) },
            new() { Range = "50-100 kcal", Count = _filteredIngredients.Count(i => i.CaloriesPerUnit >= 50 && i.CaloriesPerUnit < 100) },
            new() { Range = "100-200 kcal", Count = _filteredIngredients.Count(i => i.CaloriesPerUnit >= 100 && i.CaloriesPerUnit < 200) },
            new() { Range = "200-300 kcal", Count = _filteredIngredients.Count(i => i.CaloriesPerUnit >= 200 && i.CaloriesPerUnit < 300) },
            new() { Range = "> 300 kcal", Count = _filteredIngredients.Count(i => i.CaloriesPerUnit >= 300) }
        };
    }

    private void CalculateNutritionAverage()
    {
        if (_filteredIngredients == null || !_filteredIngredients.Any())
            return;

        var withNutrition = _filteredIngredients
            .Where(i => i.Proteins.HasValue || i.Carbohydrates.HasValue || i.Lipids.HasValue || i.Fiber.HasValue)
            .ToList();
        
        if (withNutrition.Any())
        {
            _avgProteins = withNutrition.Where(i => i.Proteins.HasValue).Average(i => i.Proteins ?? 0);
            _avgCarbs = withNutrition.Where(i => i.Carbohydrates.HasValue).Average(i => i.Carbohydrates ?? 0);
            _avgLipids = withNutrition.Where(i => i.Lipids.HasValue).Average(i => i.Lipids ?? 0);
            _avgFiber = withNutrition.Where(i => i.Fiber.HasValue).Average(i => i.Fiber ?? 0);
        }
    }

    private (string color, int width) GetCalorieBar(double calories)
    {
        if (_maxCalories == 0) return ("bg-secondary", 0);
        int width = (int)(calories / _maxCalories * 100);
        string color = calories switch
        {
            < 100 => "bg-success",
            < 300 => "bg-warning",
            _ => "bg-danger"
        };
        return (color, Math.Max(width, 5));
    }

    private (string badgeColor, string emoji) GetCategoryBadge(IngredientCategory category) => category switch
    {
        IngredientCategory.Legumes => ("bg-success", "🥬"),
        IngredientCategory.Fruits => ("bg-danger", "🍎"),
        IngredientCategory.Proteines => ("bg-info", "🍗"),
        IngredientCategory.Cereales => ("bg-warning", "🌾"),
        IngredientCategory.Produits_Laitiers => ("bg-light text-dark", "🥛"),
        IngredientCategory.Boissons => ("bg-primary", "🥤"),
        IngredientCategory.Huiles => ("bg-secondary", "🫒"),
        IngredientCategory.Condiments => ("bg-dark", "🌶️"),
        IngredientCategory.Legumineuses => ("bg-success-subtle text-success-emphasis", "🫘"),
        _ => ("bg-secondary", "📦"),
    };

    private string GetCategoryLabel(IngredientCategory category) => category switch
    {
        IngredientCategory.Legumes => "Légumes",
        IngredientCategory.Fruits => "Fruits",
        IngredientCategory.Proteines => "Protéines",
        IngredientCategory.Cereales => "Céréales",
        IngredientCategory.Produits_Laitiers => "Produits laitiers",
        IngredientCategory.Boissons => "Boissons",
        IngredientCategory.Huiles => "Huiles",
        IngredientCategory.Condiments => "Condiments",
        IngredientCategory.Legumineuses => "Légumineuses",
        _ => "Autre",
    };

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _selectedCategory = null;
        RefreshFilteredData();
    }

    private void GoToAdd() => NavManager.NavigateTo("/ingredients/ajouter");
    
    private void GoToEdit(int id) => NavManager.NavigateTo($"/ingredients/modifier/{id}");

    private async Task Delete(int id)
    {
        await IngredientService.DeleteIngredientAsync(id);
        await LoadDataAsync();
    }

    // Classes pour les données des graphiques
    public class CategoryData
    {
        public string Category { get; set; } = string.Empty;
        public int Count { get; set; }
    }

    public class CalorieRangeData
    {
        public string Range { get; set; } = string.Empty;
        public int Count { get; set; }
    }
}